<Window
    x:Class="Liuli.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel x:Name="Root" Padding="28" Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="琉璃" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Windows 预览版 · 输入翻译" Opacity="0.65" />
            <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Severity="Informational" Title="正在启动模型服务…" />
            <StackPanel x:Name="Workspace" Spacing="16" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="Models" Header="模型" DisplayMemberPath="DisplayName" MinWidth="320" MaxWidth="600" SelectionChanged="ModelChanged" />
                    <Button x:Name="RefreshButton" Content="刷新" VerticalAlignment="Bottom" Click="RefreshClicked" />
                </StackPanel>
                <TextBox x:Name="Source" Header="原文" PlaceholderText="输入需要翻译的文字" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="260" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="Target" Header="目标语言" SelectedIndex="0">
                        <ComboBoxItem Content="简体中文" Tag="zh" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="日本語" Tag="ja" />
                    </ComboBox>
                    <Button x:Name="TranslateButton" Content="翻译" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="TranslateClicked" />
                    <Button x:Name="CancelButton" Content="停止" VerticalAlignment="Bottom" IsEnabled="False" Click="CancelClicked" />
                </StackPanel>
                <TextBox x:Name="Result" Header="译文" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="400" />
                <Expander Header="账号与模型供应商" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <ComboBox x:Name="Providers" Header="供应商" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ProviderChanged" />
                        <ComboBox x:Name="AuthType" Header="登录方式" SelectedIndex="0">
                            <ComboBoxItem Content="API Key" Tag="api_key" />
                            <ComboBoxItem Content="浏览器登录 / OAuth" Tag="oauth" />
                        </ComboBox>
                        <PasswordBox x:Name="ApiKey" Header="API Key（仅用于本次登录提交）" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="LoginButton" Content="登录" Click="LoginClicked" />
                            <Button x:Name="LogoutButton" Content="退出该供应商" Click="LogoutClicked" />
                        </StackPanel>
                        <TextBlock x:Name="LoginMessage" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <HyperlinkButton x:Name="LoginLink" Content="打开登录页面" Visibility="Collapsed" Click="LoginLinkClicked" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            <Button x:Name="RestartButton" Content="重启模型服务" Click="RestartClicked" />
            <TextBlock x:Name="LogLocation" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.6" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Window>
